# Copy to .env. Optional. With a key, Claude picks and chains Till's tools in the demo page.
# Without one, the page uses its built-in keyword router. Every number comes from the MCP server either way.
ANTHROPIC_API_KEY=
TILL_AGENT_MODEL=claude-haiku-5-5
PORT=8765
# Optional. Speak Till's answers in an ElevenLabs voice (falls back to the browser voice without a key).
ELEVENLABS_API_KEY=
TILL_VOICE_ID=
# PayPal (sandbox). Create an app at developer.paypal.com; leave PAYPAL_ENV=sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Or run with no PayPal keys at all on the recorded sample data:
# PAYPAL_FIXTURES=data/paypal_fixtures
